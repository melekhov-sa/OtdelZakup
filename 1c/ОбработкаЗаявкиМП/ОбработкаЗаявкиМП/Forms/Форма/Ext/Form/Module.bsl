&НаСервере
Функция ПолучитьДвоичныеДанныеНаСервере(СсылкаХранениеТД)
	
	//++ Мелехов (фрагмент ДОБАВЛЕН) 08.05.2026 11:03:08 #5472
	Поток = Новый ПотокВПамяти();
	ХранилищеТабДок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаХранениеТД, "ХранилищеТабличныйДокумент");
	ТабличныйДокумент = ХранилищеТабДок.Получить();
	ТабличныйДокумент.Записать(Поток, ТипФайлаТабличногоДокумента.XLSX);
	ДвоичныеДанные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
	Возврат ДвоичныеДанные;
	//++ Мелехов 08.05.2026 11:03:08
	
КонецФункции

&НаКлиенте
Процедура РазобратьПрикрепленнуюТаблицуЗаявки(СсылкаХранениеТД, Подсказка = "", ИДСтроки = 0) Экспорт
	
	//++ Мелехов (фрагмент ДОБАВЛЕН) 18.03.2026 17:56:40 #5472
	ДвоичныеДанные = ПолучитьДвоичныеДанныеНаСервере(СсылкаХранениеТД);
	
	Результат = РазборЗаявокAPI.РазобратьЗаявкуИзДвоичныхДанных(ДвоичныеДанные, "Прикрепленный файл", Подсказка);
	
	Если НЕ Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;
	
	ЗанестиДанныеВЗаявку(Результат.Позиции, 3, СсылкаХранениеТД);
	
	ПоказатьОповещениеПользователя("Разбор прикрепленной таблицы");	
	
	ЗаполнитьДанныеТЗ(3, Истина, СсылкаХранениеТД);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗаявкаРазборЗаявкиОтИИ, "ПризнакРазбора", 3, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗаявкаРазборЗаявкиОтИИ, "ФайлЗаявки", СсылкаХранениеТД, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗаявкаРазборЗаявкиОтИИ, "ЕстьОтборПоФайлам", Истина, Истина);
	
	Если ИДСтроки <> 0 Тогда
		ВыбратьРазборПоИдентификатору(ИДСтроки);
	КонецЕсли;
	//++ Мелехов 18.03.2026 17:56:40
	
КонецПроцедуры


