	Если Результат.Свойство("Отмена") Тогда
		Если Результат.Отмена = Ложь Тогда
			Если Результат.Свойство("ТипРазбора") Тогда // 1 - таблица, 2 - структурированный список, свободный список
				Тип = "table";
