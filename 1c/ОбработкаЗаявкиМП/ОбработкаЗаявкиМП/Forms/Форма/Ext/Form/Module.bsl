&НаКлиенте
Процедура РазобратьДанныеФайла(ВыбранныйФайл, Подсказка = "", ИДСтроки = 0) Экспорт
	
	//++ Мелехов (фрагмент ДОБАВЛЕН) 18.03.2026 17:56:40 #5472
	ДанныеФайла = РаботаСФайламиКлиент.ДанныеФайла(ВыбранныйФайл);
	Если ЗначениеЗаполнено(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла) Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		Результат = РазборЗаявокAPI.РазобратьЗаявкуИзДвоичныхДанных(ДвоичныеДанные, ДанныеФайла.ИмяФайла, Подсказка);
		
		Если НЕ Результат.Успех Тогда
			ПоказатьПредупреждение(, Результат.Ошибка);
			Возврат;
		КонецЕсли;
		
		ЗанестиДанныеВЗаявку(Результат.Позиции, 2, ВыбранныйФайл);
		
		ПоказатьОповещениеПользователя("Разбор заявки");	
		
		ЗаполнитьДанныеТЗ(2, Истина, ВыбранныйФайл);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗаявкаРазборЗаявкиОтИИ, "ПризнакРазбора", 2, Истина);
