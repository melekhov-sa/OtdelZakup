&НаСервере
Процедура ЗагрузитьДанныеНаСервере()
	
	//++ Мелехов (фрагмент ДОБАВЛЕН) 18.03.2026 17:21:11 #5472
	ФайлыСогласования.Очистить();
	РазобранныеФайлы.Очистить();
	РазобранныеПозиции.Очистить();
	
	ТекстЗаявки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкиОтделаПродажПоЗакупкам.КомментарийМП КАК КомментарийМП
	|ИЗ
	|	Справочник.ЗаявкиОтделаПродажПоЗакупкам КАК ЗаявкиОтделаПродажПоЗакупкам
	|ГДЕ
	|	ЗаявкиОтделаПродажПоЗакупкам.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекстЗаявки = ВыборкаДетальныеЗаписи.КомментарийМП;
	КонецЦикла;
	
	ИДСтроки = 0;
	
	НовЭл = РазобранныеФайлы.Добавить();
	НовЭл.ОбъектРазбора = "Текст заявки";
	НовЭл.Выбран = Ложь;
	НовЭл.ПризнакОбъекта = 1;
	НовЭл.Разобран = "Разобрать";
	НовЭл.Открыть = "текст заявки ->";
	НовЭл.ИДСтроки = ИДСтроки;
	
	ИДСтроки = ИДСтроки + 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы.Наименование КАК Наименование,
	|	ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы.Расширение КАК Расширение
	|ИЗ
	|	Справочник.ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы КАК ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы
	|ГДЕ
	|	ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
	|	И ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ВладелецФайла", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовЭл = РазобранныеФайлы.Добавить();
		НовЭл.Файл = ВыборкаДетальныеЗаписи.Ссылка;
		НовЭл.ПредставлениеФайла = ВыборкаДетальныеЗаписи.Наименование;
		НовЭл.ОбъектРазбора = "Файл - " + ВыборкаДетальныеЗаписи.Наименование;
		НовЭл.Выбран = Ложь;
		НовЭл.ПризнакОбъекта = 2;
		НовЭл.Разобран = "Разобрать";
		НовЭл.Открыть = "Открыть";
		НовЭл.Формат = ВыборкаДетальныеЗаписи.Расширение;
		НовЭл.ИДСтроки = ИДСтроки;
		ИДСтроки = ИДСтроки + 1;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХранениеТабличныхДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХранениеТабличныхДокументов КАК ХранениеТабличныхДокументов
	|ГДЕ
	|	ХранениеТабличныхДокументов.ВладелецТД = &ВладелецТД";
	
	Запрос.УстановитьПараметр("ВладелецТД", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовЭл = РазобранныеФайлы.Добавить();
		НовЭл.Файл = ВыборкаДетальныеЗаписи.Ссылка;
		НовЭл.Открыть = "Открыть";
		НовЭл.ОбъектРазбора = "Прикрепленная таблица";
		НовЭл.ПризнакОбъекта = 3;
		НовЭл.Разобран = "Разобрать";
		НовЭл.ПредставлениеФайла = "Прикрепленная таблица";
		НовЭл.ИДСтроки = ИДСтроки;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ.ПризнакРазбора КАК ПризнакРазбора,
	|	ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ.ДатаРазбора КАК ДатаРазбора,
	|	ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ.ФайлЗаявки КАК ФайлЗаявки
	|ИЗ
	|	Справочник.ЗаявкиОтделаПродажПоЗакупкам.РазборЗаявкиОтИИ КАК ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ
	|ГДЕ
	|	ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ.ФайлЗаявки,
	|	ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ.ПризнакРазбора,
	|	ЗаявкиОтделаПродажПоЗакупкамРазборЗаявкиОтИИ.ДатаРазбора";
	
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ПризнакРазбора = 1 Тогда
			СтрокиТЗ = РазобранныеФайлы.НайтиСтроки(Новый Структура("ПризнакОбъекта", 1));
			Если СтрокиТЗ.Количество() = 1 Тогда
				СтрокиТЗ[0].Разобран = "Перейти";
				СтрокиТЗ[0].РазобратьЗаново = "Разобрать";
			КонецЕсли;
		ИначеЕсли ВыборкаДетальныеЗаписи.ПризнакРазбора = 2 Тогда
			СтрокиТЗ = РазобранныеФайлы.НайтиСтроки(Новый Структура("ПризнакОбъекта, Файл", 2, ВыборкаДетальныеЗаписи.ФайлЗаявки));
			Если СтрокиТЗ.Количество() = 1 Тогда
				СтрокиТЗ[0].Разобран = "Перейти";
				СтрокиТЗ[0].РазобратьЗаново = "Разобрать";
			КонецЕсли;
		ИначеЕсли ВыборкаДетальныеЗаписи.ПризнакРазбора = 3 Тогда
			СтрокиТЗ = РазобранныеФайлы.НайтиСтроки(Новый Структура("ПризнакОбъекта, Файл", 3, ВыборкаДетальныеЗаписи.ФайлЗаявки));
			Если СтрокиТЗ.Количество() = 1 Тогда
				СтрокиТЗ[0].Разобран = "Перейти";
				СтрокиТЗ[0].РазобратьЗаново = "Разобрать";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗаявкаРазборЗаявкиОтИИ.Параметры.УстановитьЗначениеПараметра("Ссылка", Заявка);
	ЗаявкаРазборЗаявкиОтИИ.Параметры.УстановитьЗначениеПараметра("ПризнакРазбора", 0);
	ЗаявкаРазборЗаявкиОтИИ.Параметры.УстановитьЗначениеПараметра("ЕстьОтборПоФайлам", Ложь);
	ЗаявкаРазборЗаявкиОтИИ.Параметры.УстановитьЗначениеПараметра("ФайлЗаявки", Справочники.ХранениеТабличныхДокументов.ПустаяСсылка());
	//++ Мелехов 18.03.2026 17:21:11
	
