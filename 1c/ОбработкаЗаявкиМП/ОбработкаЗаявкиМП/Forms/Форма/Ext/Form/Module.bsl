&НаСервере
Процедура ОтчиститьДанныеВЗаявкеПоРазбору(ПризнакРазбора, ФайлЗаявки = Неопределено)
	
	//++ Мелехов (фрагмент ДОБАВЛЕН) 24.04.2026 16:39:56 #5472
	ОбъектЗаявка = Заявка.ПолучитьОбъект();
	
	СтруктураДляПоиска = Новый Структура("ПризнакРазбора", ПризнакРазбора);
	
	Если ФайлЗаявки <> Неопределено Тогда
		СтруктураДляПоиска.Вставить("ФайлЗаявки", ФайлЗаявки); 
	КонецЕсли;
	
	ТабличнаяЧастьСпр = ОбъектЗаявка.РазборЗаявкиОтИИ;
	МассивСтрокРазбора = ТабличнаяЧастьСпр.НайтиСтроки(СтруктураДляПоиска);

	//++ Мелехов (фрагмент ДОБАВЛЕН) 16.08.2026 14:20:00 #5473
	// Кандидаты живут в отдельной табличной части и связаны с удаляемыми
	// строками по идентификатору. Без этой чистки они остались бы сиротами
	// и накапливались при каждом повторном разборе.
	УдаляемыеИдентификаторы = Новый Массив;
	Для Каждого Строка Из МассивСтрокРазбора Цикл
		Если ЗначениеЗаполнено(Строка.ИДСтрокиРазбора) Тогда
			УдаляемыеИдентификаторы.Добавить(Строка.ИДСтрокиРазбора);
		КонецЕсли;
	КонецЦикла;

	УдалитьКандидатов(ОбъектЗаявка, УдаляемыеИдентификаторы);
	//++ Мелехов 16.08.2026 14:20:00

	Для каждого Строка Из МассивСтрокРазбора Цикл
		ТабличнаяЧастьСпр.Удалить(Строка);
	КонецЦикла;

	ОбъектЗаявка.Записать();
	//++ Мелехов 24.04.2026 16:39:56
	
КонецПроцедуры

//++ Мелехов (фрагмент ДОБАВЛЕН) 16.08.2026 14:20:00 #5473
// Записывает варианты подбора, присланные сервисом, в табличную часть заявки.
//
// Наименование кандидата хранится отдельно от ссылки: если позиции с таким
// УИД в базе нет, МЗ должна видеть хотя бы то, что предлагала система.
//
// Параметры:
//  ОбъектЗаявка    - СправочникОбъект.ЗаявкиОтделаПродажПоЗакупкам
//  ИДСтрокиРазбора - Строка - ключ строки разбора
//  Поз             - Структура - позиция ответа сервиса
//
&НаСервере
Процедура ЗаписатьКандидатов(ОбъектЗаявка, ИДСтрокиРазбора, Поз)

	Если Не Поз.Свойство("Кандидаты") Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Поз.Кандидаты) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Кандидат Из Поз.Кандидаты Цикл

		НоваяСтрока = ОбъектЗаявка.КандидатыПодбора.Добавить();
		НоваяСтрока.ИДСтрокиРазбора = ИДСтрокиРазбора;
		НоваяСтрока.Ранг = Кандидат.Ранг;
		НоваяСтрока.УИД_1С = Кандидат.УИД_1С;
		НоваяСтрока.НаименованиеКандидата = Кандидат.Наименование;
		НоваяСтрока.Совпадение = Кандидат.Совпадение;
		НоваяСтрока.ПутьДоПозиции = Кандидат.ПутьДоПозиции;

		Если ЗначениеЗаполнено(Кандидат.УИД_1С) Тогда
			НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Кандидат.УИД_1С));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Удаляет кандидатов по идентификаторам удаляемых строк разбора.
//
// Параметры:
//  ОбъектЗаявка    - СправочникОбъект.ЗаявкиОтделаПродажПоЗакупкам
//  Идентификаторы  - Массив из Строка
//
&НаСервере
Процедура УдалитьКандидатов(ОбъектЗаявка, Идентификаторы)

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	УдаляемыеСтроки = Новый Массив;

	Для Каждого СтрокаКандидата Из ОбъектЗаявка.КандидатыПодбора Цикл
		Если Идентификаторы.Найти(СтрокаКандидата.ИДСтрокиРазбора) <> Неопределено Тогда
			УдаляемыеСтроки.Добавить(СтрокаКандидата);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаКандидата Из УдаляемыеСтроки Цикл
		ОбъектЗаявка.КандидатыПодбора.Удалить(СтрокаКандидата);
	КонецЦикла;

КонецПроцедуры
//++ Мелехов 16.08.2026 14:20:00

&НаСервере
Процедура ЗанестиДанныеВЗаявку(Позиции, ПризнакРазбора, ФайлЗаявки = Неопределено)
	
	//++ Мелехов (фрагмент ДОБАВЛЕН) 24.04.2026 16:39:56 #5472
	ОбъектЗаявка = Заявка.ПолучитьОбъект();
	А = 1;
	Для Каждого Поз Из Позиции Цикл
		НоваяСтрока = ОбъектЗаявка.РазборЗаявкиОтИИ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Поз);
		НоваяСтрока.ДатаРазбора = ТекущаяДатаСеанса();
		НоваяСтрока.ПризнакРазбора = ПризнакРазбора;
		Если ФайлЗаявки <> Неопределено Тогда
			НоваяСтрока.ФайлЗаявки = ФайлЗаявки; 
		КонецЕсли;
		Если ЗначениеЗаполнено(Поз.УИД_1С) Тогда
			НеобходимыйТовар = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Поз.УИД_1С));
			НоваяСтрока.НашаНоменклатура = НеобходимыйТовар;
		КонецЕсли;
		НоваяСтрока.Пользователь = Пользователи.ТекущийПользователь();
		НоваяСтрока.НомерПозиции = А;
		НоваяСтрока.ПутьДоПозиции = Поз.ПутьДоПозиции;
		НоваяСтрока.Покраска = Поз.Покраска;
		НоваяСтрока.Длина = Поз.Длина;
		НоваяСтрока.Материал = Поз.Материал;

		//++ Мелехов (фрагмент ДОБАВЛЕН) 16.08.2026 14:20:00 #5473
		// Устойчивый ключ строки. Прежний составной ключ (признак разбора, дата,
		// наименование, номер позиции) не различает две одинаковые позиции в
		// одной заявке - из-за этого молча терялись комментарии МЗ.
		НоваяСтрока.ИДСтрокиРазбора = Строка(Новый УникальныйИдентификатор());

		ЗаписатьКандидатов(ОбъектЗаявка, НоваяСтрока.ИДСтрокиРазбора, Поз);
		//++ Мелехов 16.08.2026 14:20:00

		А = А + 1;
	КонецЦикла;
	ОбъектЗаявка.Записать();
	//++ Мелехов 24.04.2026 16:39:56
	
КонецПроцедуры

&НаКлиенте
Процедура РазобранныеФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//++ Мелехов (фрагмент ДОБАВЛЕН) 27.04.2026 10:35:07 #5472
	СтандартнаяОбработка = Ложь;
	Если Элементы.РазобранныеФайлы.ТекущиеДанные.ОбъектРазбора <> Неопределено Тогда
		Если Поле = Элементы.РазобранныеФайлыОткрыть Тогда // пытаемся открыть файл
			Если Элементы.РазобранныеФайлы.ТекущиеДанные.ПризнакОбъекта <> 1 Тогда
				Если Элементы.РазобранныеФайлы.ТекущиеДанные.Открыть = "Открыть" Тогда
					Если ТипЗнч(Элементы.РазобранныеФайлы.ТекущиеДанные.Файл) = Тип("СправочникСсылка.ЗаявкиОтделаПродажПоЗакупкамПрисоединенныеФайлы") Тогда
